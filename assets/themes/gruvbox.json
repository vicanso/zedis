          "string.escape": {
            "color": "#76BA53"
          },
          "string.regex": {
            "color": "#76BA53"
          },
          "string.special": {
            "color": "#E1D797"
          },
          "string.special.symbol": {
            "color": "#E1D797"
          },
          "tag": {
            "color": "#b5af9a"
          },
          "text.literal": {
            "color": "#E1D797"
          },
          "title": {
            "color": "#A76D3B",
            "font_weight": 600
          },
          "type": {
            "color": "#A86D3B"
          },
          "property": {
            "color": "#CACCCA"
          },
          "variable.special": {
            "color": "#E19773"
          }
        }
