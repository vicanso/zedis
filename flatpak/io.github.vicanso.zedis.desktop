[Desktop Entry]
Name=Zedis
Comment=GPU-accelerated Redis GUI client
Exec=zedis %u
Icon=io.github.vicanso.zedis
Type=Application
Terminal=false
Categories=Development;Database;
MimeType=x-scheme-handler/redis;x-scheme-handler/rediss;
Keywords=redis;valkey;database;gui;client;
# Flatpak sets FLATPAK_ID=io.github.vicanso.zedis; the binary uses that as
# the Wayland app_id so this desktop entry is matched for name + icon.
StartupWMClass=io.github.vicanso.zedis
StartupNotify=true
